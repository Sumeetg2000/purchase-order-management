  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -b tsconfig.build.json",
    "typecheck": "prisma generate && tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "admin": "node dist/cli/admin.js",
