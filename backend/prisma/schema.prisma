// Prisma 7 schema (research R8). Triggers, functions, CHECKs and grants live as raw SQL
// in the migrations. The connection URL comes from prisma.config.ts (CLI) and from the
// driver adapter (runtime).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Minimal users table (migration 0002_users). Never deleted: po_app has no DELETE.
model User {
  id            String    @id @db.Uuid
  name          String
  email         String    @unique(map: "users_email_key")
  roles         String[]  @default([])
  status        String
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  passwordHash  String?   @map("password_hash")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

// Audit trail (migration 0003_audit). Writes go only through writeAudit (src/audit), whose
// INSERT the triggers complete from the actor context; po_app can't update or delete. The
// model keeps this schema a full description of the database (the migrations test diffs
// them) and serves reads in later slices.
model AuditEntry {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorType   String   @map("actor_type")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorName   String?  @map("actor_name")
  actorEmail  String?  @map("actor_email")
  actingRole  String?  @map("acting_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  orderId     String?  @map("order_id") @db.Uuid
  poNumber    String?  @map("po_number")
  details     Json     @default("{}")
  requestId   String?  @map("request_id")

  @@index([occurredAt, id])
  @@map("audit_entries")
}
