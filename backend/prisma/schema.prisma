// Prisma 7 schema (research R8). Triggers, functions, CHECKs and grants live as raw SQL
// in the migrations. The connection URL comes from prisma.config.ts (CLI) and from the
// driver adapter (runtime).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Users (migrations 0002_users and 0007_user_accounts). Never deleted: po_app has no
// DELETE. The lower(name) and lower(email) prefix indexes are expression indexes, which
// Prisma can't express; tests/integration/accounts-schema.test.ts pins them.
model User {
  id                    String           @id @db.Uuid
  name                  String
  email                 String           @unique(map: "users_email_key")
  roles                 String[]         @default([])
  status                String
  deactivatedAt         DateTime?        @map("deactivated_at") @db.Timestamptz(6)
  passwordHash          String?          @map("password_hash")
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastLoginAt           DateTime?        @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount      Int              @default(0) @map("failed_login_count")
  lockedUntil           DateTime?        @map("locked_until") @db.Timestamptz(6)
  tokens                OneTimeToken[]
  sessions              Session[]
  accessRequests        AccessRequest[]  @relation("AccessRequestUser")
  decidedAccessRequests AccessRequest[]  @relation("AccessRequestDecider")
  orders                PurchaseOrder[]
  idempotencyKeys       IdempotencyKey[]

  @@index([name, id], map: "users_name_id_idx")
  @@index([status, name, id], map: "users_status_name_id_idx")
  @@map("users")
}

// Audit trail (migration 0003_audit). Writes go only through writeAudit (src/audit), whose
// INSERT the triggers complete from the actor context; po_app can't update or delete. The
// model keeps this schema a full description of the database (the migrations test diffs
// them) and serves reads in later slices.
model AuditEntry {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorType   String   @map("actor_type")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorName   String?  @map("actor_name")
  actorEmail  String?  @map("actor_email")
  actingRole  String?  @map("acting_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  orderId     String?  @map("order_id") @db.Uuid
  poNumber    String?  @map("po_number")
  details     Json     @default("{}")
  requestId   String?  @map("request_id")

  @@index([occurredAt, id])
  @@index([entityType, entityId, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_entries_entity_idx")
  @@map("audit_entries")
}

// One-time tokens (migration 0005_one_time_tokens). Only the SHA-256 hash is stored, and
// po_app can update only used_at and superseded_at. The partial index for superseding and
// the purge's expression index live in the migration only: Prisma can't express the
// expression index, and the partial one needs a preview feature. prisma migrate diff
// ignores both, so tests/integration/tokens.test.ts pins their definitions.
model OneTimeToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  purpose      String
  tokenHash    Bytes     @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("one_time_tokens")
}

// Sessions (migration 0008_sessions): one login on one device. The partial index of active
// sessions and the purge's expression index live in the migration only; the accounts
// schema test pins them.
model Session {
  id                String         @id @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  createdAt         DateTime       @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime       @map("last_used_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime       @map("absolute_expires_at") @db.Timestamptz(6)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  userAgent         String         @map("user_agent")
  ip                String         @db.Inet
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?        @map("revoke_reason")
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refreshTokens     RefreshToken[]

  @@map("sessions")
}

// Refresh tokens (migration 0008_sessions): only the SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash Bytes     @unique(map: "refresh_tokens_token_hash_key") @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt DateTime  @map("created_at") @db.Timestamptz(6)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([sessionId], map: "refresh_tokens_session_id_idx")
  @@map("refresh_tokens")
}

// Access requests (migration 0009_access_requests). The one-open-per-user partial unique
// index lives in the migration only; the accounts schema test pins it.
model AccessRequest {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  message   String
  status    String
  adminNote String?   @map("admin_note")
  decidedBy String?   @map("decided_by") @db.Uuid
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User      @relation("AccessRequestUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decider   User?     @relation("AccessRequestDecider", fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, updatedAt(sort: Desc), id(sort: Desc)], map: "access_requests_status_updated_idx")
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "access_requests_updated_idx")
  @@index([userId, createdAt(sort: Desc)], map: "access_requests_user_latest_idx")
  @@map("access_requests")
}

// Rate-limit counters (migration 0010_rate_limits): one fixed window per bucket and key.
model RateLimitCounter {
  bucket      String
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd   DateTime @map("window_end") @db.Timestamptz(6)
  hits        Int

  @@id([bucket, key, windowStart], map: "rate_limit_counters_pkey")
  @@index([windowEnd], map: "rate_limit_counters_window_end_idx")
  @@map("rate_limit_counters")
}

// Vendors (migration 0011_vendors). Never deleted: po_app has no DELETE. name_key is a
// stored generated column, vendor_name_key(name): read it, never write it; po_app has no
// INSERT or UPDATE grant on it. The CHECKs, the trigger and the column grants live in the
// migration; tests/integration/vendor-schema.test.ts pins them.
model Vendor {
  id              String          @id @db.Uuid
  name            String
  nameKey         String?         @unique(map: "vendors_name_key_key") @default(dbgenerated("vendor_name_key(name)")) @map("name_key")
  contactName     String          @map("contact_name")
  contactEmail    String          @map("contact_email")
  contactPhone    String?         @map("contact_phone")
  paymentTermType String          @map("payment_term_type")
  netDays         Int?            @map("net_days") @db.SmallInt
  advancePercent  Int?            @map("advance_percent") @db.SmallInt
  status          String          @default("ACTIVE")
  deactivatedAt   DateTime?       @map("deactivated_at") @db.Timestamptz(6)
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  orders          PurchaseOrder[]

  @@index([status, nameKey], map: "vendors_status_name_key_idx")
  @@map("vendors")
}

// Orders (migration 0013_orders). The derived columns (total, open_line_count, line_total)
// and received_quantity are read-only for po_app: repositories read them as text and never
// write them (ADR-0003, ADR-0010). The triggers that keep them live in the migration only.
// po_number is COLLATE "C" in the database, which Prisma can't express.
model PurchaseOrder {
  id            String      @id @db.Uuid
  poNumber      String?     @unique(map: "purchase_orders_po_number_key") @map("po_number")
  ownerId       String      @map("owner_id") @db.Uuid
  vendorId      String      @map("vendor_id") @db.Uuid
  status        String      @default("DRAFT")
  total         Decimal     @default(0) @db.Decimal(22, 4)
  openLineCount Int         @default(0) @map("open_line_count")
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor        Vendor      @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines         OrderLine[]

  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)], map: "purchase_orders_owner_created_idx")
  @@index([ownerId, status, createdAt(sort: Desc), id(sort: Desc)], map: "purchase_orders_owner_status_created_idx")
  @@index([ownerId, vendorId, createdAt(sort: Desc), id(sort: Desc)], map: "purchase_orders_owner_vendor_created_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "purchase_orders_created_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "purchase_orders_status_created_idx")
  @@index([vendorId, createdAt(sort: Desc), id(sort: Desc)], map: "purchase_orders_vendor_created_idx")
  @@index([ownerId, poNumber], map: "purchase_orders_owner_po_number_idx")
  @@map("purchase_orders")
}

model OrderLine {
  id               String        @id @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  position         Int
  description      String
  quantity         Int
  unitPrice        Decimal       @map("unit_price") @db.Decimal(13, 4)
  lineTotal        Decimal?      @default(dbgenerated("((quantity)::numeric * unit_price)")) @map("line_total") @db.Decimal(22, 4)
  receivedQuantity Int           @default(0) @map("received_quantity")
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, position], map: "order_lines_order_position_key")
  @@map("order_lines")
}

model PoNumberCounter {
  fy        String @id
  lastValue BigInt @map("last_value")

  @@map("po_number_counters")
}

model OrderStatusTransition {
  fromStatus String @map("from_status")
  toStatus   String @map("to_status")

  @@id([fromStatus, toStatus])
  @@map("order_status_transitions")
}

model IdempotencyKey {
  userId      String   @map("user_id") @db.Uuid
  operation   String
  key         String   @db.Uuid
  requestHash Bytes    @map("request_hash")
  status      Int?     @db.SmallInt
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, operation, key])
  @@index([createdAt], map: "idempotency_keys_created_at_idx")
  @@map("idempotency_keys")
}
