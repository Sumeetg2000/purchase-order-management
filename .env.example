# Local setup for `docker compose up` (contracts/config.md in specs/001-foundation).
# Copy to .env. The repository is public, so this file holds placeholders only.
# Every secret starts with "change-me-": fine for a local stack, refused when
# APP_ENV=production. CI replaces them with random values (scripts/ci-env.sh).
#
# Composed by docker-compose.yml from the values below, not set here:
#   composed: DATABASE_URL, OWNER_DATABASE_URL, MAINTENANCE_DATABASE_URL

# --- Environment -------------------------------------------------------------
APP_ENV=local
COMPOSE_PROFILES=local
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
LOG_LEVEL=info

# --- Database (each role has its own password; all different) ---------------
POSTGRES_PASSWORD=change-me-postgres-local-only
DB_OWNER_PASSWORD=change-me-owner-local-only
DB_APP_PASSWORD=change-me-app-local-only
DB_MAINTENANCE_PASSWORD=change-me-maint-local-only
DB_POOL_SIZE=10
DB_TX_TIMEOUT_MS=5000
DB_TX_MAX_WAIT_MS=2000

# --- API ----------------------------------------------------------------------
HTTP_PORT=3000
METRICS_PORT=9464

# --- Mail (Mailpit under the local profile) -----------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.local

# --- Seed and bootstrap ---------------------------------------------------------
SEED_DEMO_DATA=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_NAME=Local Admin

# --- Maintenance ----------------------------------------------------------------
PURGE_INTERVAL_HOURS=24
