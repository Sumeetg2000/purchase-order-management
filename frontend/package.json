{
  "name": "@po/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -b ../packages/contracts/tsconfig.build.json",
    "test": "vitest run",
    "contract:types": "openapi-typescript ../packages/contracts/openapi/openapi.json --output src/api/schema.d.ts"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "browserslist": "4.29.4",
    "browserslist-to-esbuild": "2.1.1",
    "openapi-typescript": "7.13.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@po/contracts": "0.0.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
