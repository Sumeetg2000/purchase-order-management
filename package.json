{
  "name": "purchase-order-management",
  "private": true,
  "description": "Vendor & Purchase Order Management",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run generate -w @po/backend && npm run build -w @po/contracts && node scripts/dev-env.mjs services && concurrently --kill-others --names api,web \"node scripts/dev-env.mjs api tsx watch --clear-screen=false backend/src/server.ts\" \"npm run dev -w @po/frontend\"",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\" && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/node-test-reporter.mjs --test-reporter-destination=reports/node-scripts.json 'scripts/tests/*.test.mjs'",
    "format": "prettier --write .",
    "prelint": "npm run generate -w @po/backend && npm run build -w @po/contracts",
    "check:traceability": "node scripts/check-traceability.mjs",
    "check:ids": "node scripts/check-requirement-ids.mjs",
    "contract:generate": "npm run build -w @po/contracts && node packages/contracts/scripts/write-openapi.mjs",
    "contract:types": "npm run contract:types -w @po/frontend",
    "e2e": "npm run e2e -w @po/frontend",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "prepare": "node -e \"if (require('node:fs').existsSync('.git')) require('node:child_process').execFileSync('npx', ['--no-install', 'lefthook', 'install'], { stdio: 'inherit' })\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "cpu-features": false,
    "ssh2": false,
    "protobufjs": false,
    "unrs-resolver": false,
    "lefthook": false
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "6.0.3"
    },
    "playwright-core": "1.64.0",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
