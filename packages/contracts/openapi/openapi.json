{
  "openapi": "3.1.0",
  "info": {
    "title": "Vendor & Purchase Order Management API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Same-origin prefix. nginx (and the Vite dev proxy) strips /api before forwarding."
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness. The process is up and serving.",
        "x-access": "public",
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Problem document with code VALIDATION_FAILED.",
            "x-error-codes": [
              "VALIDATION_FAILED"
            ],
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Problem document with code INTERNAL_ERROR.",
            "x-error-codes": [
              "INTERNAL_ERROR"
            ],
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Readiness. The database is reachable and migrations are complete.",
        "x-access": "public",
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "400": {
            "description": "Problem document with code VALIDATION_FAILED.",
            "x-error-codes": [
              "VALIDATION_FAILED"
            ],
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Problem document with code INTERNAL_ERROR.",
            "x-error-codes": [
              "INTERNAL_ERROR"
            ],
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Problem document with code SERVICE_UNAVAILABLE.",
            "x-error-codes": [
              "SERVICE_UNAVAILABLE"
            ],
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "correlationId": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ],
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "CSRF_REJECTED",
          "NOT_FOUND",
          "PAYLOAD_TOO_LARGE",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE",
          "CONCURRENCY_RETRY_EXHAUSTED"
        ],
        "description": "Every code in the registry (packages/contracts/src/errors.ts)."
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "MALFORMED_JSON",
              "UNSUPPORTED_MEDIA_TYPE",
              "REQUIRED",
              "UNKNOWN_FIELD",
              "INVALID_FORMAT",
              "TOO_SHORT",
              "TOO_LONG",
              "OUT_OF_RANGE"
            ]
          }
        },
        "required": [
          "path",
          "code"
        ],
        "additionalProperties": false
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ready"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "const": "ok"
              },
              "migrations": {
                "type": "string",
                "const": "ok"
              }
            },
            "required": [
              "database",
              "migrations"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Correlation id. If the client sends a value matching ^[A-Za-z0-9._-]{8,36}$ (room for a UUID), it is echoed back; otherwise a generated UUIDv7 is returned.",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{8,36}$"
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Any error, in RFC 9457 format.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
