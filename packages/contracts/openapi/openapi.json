          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Problem document with code VALIDATION_FAILED.",
            "x-error-codes": [
              "VALIDATION_FAILED"
            ],
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
