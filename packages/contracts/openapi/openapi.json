                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "423": {
            "description": "Problem document with code ACCOUNT_LOCKED.",
            "x-error-codes": [
              "ACCOUNT_LOCKED"
            ],
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait.",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Seconds to wait."
                }
              }
            },
            "content": {
