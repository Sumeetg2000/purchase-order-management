    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Log in with email and password; sets the session cookies.",
        "x-access": "public",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "Set-Cookie": {
                "required": true,
                "description": "The session cookies: po_access, po_refresh and po_csrf (ADR-0017).",
                "schema": {
                  "type": "string",
                  "description": "The session cookies: po_access, po_refresh and po_csrf (ADR-0017)."
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "Problem document with code VALIDATION_FAILED.",
            "x-error-codes": [
              "VALIDATION_FAILED"
            ],
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Problem document with code PASSWORD_NOT_SET or INCORRECT_PASSWORD or ACCOUNT_NOT_VERIFIED or ACCOUNT_DEACTIVATED.",
            "x-error-codes": [
              "PASSWORD_NOT_SET",
              "INCORRECT_PASSWORD",
              "ACCOUNT_NOT_VERIFIED",
              "ACCOUNT_DEACTIVATED"
